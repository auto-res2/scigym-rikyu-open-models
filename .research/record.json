              "model": "gpt-4.1",
              "supported": true
            }
          ]
        },
        {
          "id": "s1.p2",
          "node_type": "setup",
          "quote": "Due to computational resource constraints, we restricted our evaluation to SCIGYM-small, with a total of 137 tasks.",
          "judgments": [
